{
  "info": {
    "name": "Kloudspot Assignment",
    "description": "Run in order against a local development instance. The final request deletes the example record.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "employeeId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Create employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/employees",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Ananya Rao\",\n  \"email\": \"ananya.rao@example.com\",\n  \"phoneNumber\": \"+91 98765 43210\",\n  \"department\": \"ENGINEERING\",\n  \"designation\": \"Backend Engineer\",\n  \"dateOfJoining\": \"2024-07-01\",\n  \"salary\": 650000.5,\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"employeeId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Search and filter",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/employees?search=ananya&department=ENGINEERING&status=ACTIVE&page=0&size=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "View employee",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/employees/{{employeeId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Update employee",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/employees/{{employeeId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Ananya Rao\",\n  \"email\": \"ananya.rao@example.com\",\n  \"phoneNumber\": \"+91 98765 43210\",\n  \"department\": \"ENGINEERING\",\n  \"designation\": \"Software Engineer\",\n  \"dateOfJoining\": \"2024-07-01\",\n  \"salary\": 700000,\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Directory totals",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/employees/summary"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject duplicate email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/employees",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Ananya Rao\",\n  \"email\": \"ananya.rao@example.com\",\n  \"phoneNumber\": \"+91 98765 43210\",\n  \"department\": \"ENGINEERING\",\n  \"designation\": \"Backend Engineer\",\n  \"dateOfJoining\": \"2024-07-01\",\n  \"salary\": 650000.5,\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 409\", function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject invalid salary",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/employees",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Ananya Rao\",\n  \"email\": \"invalid.salary@example.com\",\n  \"phoneNumber\": \"+91 98765 43210\",\n  \"department\": \"ENGINEERING\",\n  \"designation\": \"Backend Engineer\",\n  \"dateOfJoining\": \"2024-07-01\",\n  \"salary\": -1,\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 400\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete example employee",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/employees/{{employeeId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    }
  ]
}
