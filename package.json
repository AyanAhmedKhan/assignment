{
  "name": "klodspot-assignment-browser-tests",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{java,js,html,css}\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{java,js,html,css}\" \"tests/**/*.js\"",
    "test:auth": "playwright test --config=playwright.auth.config.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.58.2",
    "prettier": "3.9.10",
    "prettier-plugin-java": "2.11.0"
  }
}
